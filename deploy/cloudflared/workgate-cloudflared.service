[Unit]
Description=Cloudflare Tunnel for Workgate
After=network.target

[Service]
Type=simple
User=cloudflared
Group=cloudflared
ExecStart=/usr/bin/cloudflared tunnel --no-autoupdate run --token-file /etc/cloudflared/workgate.token
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
