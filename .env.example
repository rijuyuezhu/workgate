# shellcheck shell=sh
# shellcheck disable=SC2034
# Copy it with: cp .env.example .env

# Server.
# Server transport mode.
# Choices: mcp, http, both, stdio.
WORKGATE_MODE=mcp
# Bind host for HTTP/MCP transports.
WORKGATE_HOST=0.0.0.0
# Bind port for HTTP/MCP transports.
WORKGATE_PORT=8765

# Human interface.
# Mount the browser Human UI and its authenticated API on the HTTP server.
WORKGATE_UI_ENABLED=true
# Non-root URL path where the browser Human UI is mounted.
WORKGATE_UI_PATH=/ui
# Optional administrator-supplied OpenTUI executable command.
WORKGATE_UI_TUI_COMMAND=
# Idle timeout for authenticated Human UI terminal WebSockets; 0 disables idle expiry.
WORKGATE_UI_TERMINAL_IDLE_TIMEOUT_S=3600
# Maximum concurrent Human UI terminal WebSocket connections.
WORKGATE_UI_TERMINAL_MAX_CONNECTIONS=8
# Browser Human UI background treatment; no external network image is fetched.
# Choices: aurora, grid, none.
WORKGATE_UI_WALLPAPER=aurora

# Paths and state.
# Workspace filesystem boundary; defaults to the directory Workgate was started from.
# Default when omitted: invocation CWD.
# WORKGATE_WORKSPACE_ROOT=/absolute/path/to/workspace
# Directory for durable Workgate runtime state.
# Default when omitted: platform user-state directory.
# WORKGATE_STATE_DIR=/absolute/path/to/workgate-state

# Authentication and OAuth.
# Authentication mode. Do not expose public services with none.
# Choices: none, oauth.
WORKGATE_AUTH_MODE=oauth
# Allow localhost requests without bearer authentication. Keep disabled when exposing HTTP through
# proxies or shared hosts.
WORKGATE_AUTH_BYPASS_LOCALHOST=false
# Idle timeout for stateful Streamable HTTP MCP sessions in seconds.
WORKGATE_MCP_SESSION_IDLE_TIMEOUT_S=180
# Maximum concurrent stateful Streamable HTTP MCP sessions.
WORKGATE_MCP_MAX_SESSIONS=1024
# Externally reachable base URL used for OAuth metadata, callbacks, and generated links. If unset,
# URLs fall back to the bind host and port; configure this before exposing the service behind a proxy
# or public hostname.
WORKGATE_BASE_URL=
# Override URL for OAuth issuer metadata; usually derived from base_url.
WORKGATE_OAUTH_ISSUER=
# Override URL for OAuth resource metadata; usually derived from base_url plus /mcp.
WORKGATE_OAUTH_RESOURCE=
# Admin PIN required to approve OAuth authorization. Public OAuth URLs require a non-placeholder value
# of at least 8 characters.
WORKGATE_OAUTH_ADMIN_PIN=
# Bearer token lifetime in seconds. After this time, the token must be re-authorized and refreshed.
WORKGATE_OAUTH_ACCESS_TOKEN_TTL_S=3600
# OAuth authorization-code lifetime in seconds. The authorization must be done within this time.
WORKGATE_OAUTH_CODE_TTL_S=300
# Maximum unused, unexpired OAuth authorization codes kept in memory; set to 0 to disable this
# capacity limit.
WORKGATE_OAUTH_MAX_PENDING_CODES=2048
# Pending OAuth client registration lifetime in seconds. Approved clients are persisted without this
# TTL; set to 0 to disable pending expiration.
WORKGATE_OAUTH_CLIENT_TTL_S=86400
# Maximum pending OAuth client registrations kept in memory. Approved clients do not count; set to 0
# to disable this capacity limit.
WORKGATE_OAUTH_MAX_DYNAMIC_CLIENTS=256
# Maximum JSON body size accepted by dynamic OAuth client registration.
WORKGATE_OAUTH_REGISTRATION_MAX_BODY_BYTES=16384
# Maximum redirect URIs accepted in one dynamic OAuth client registration.
WORKGATE_OAUTH_REGISTRATION_MAX_REDIRECT_URIS=10
# Maximum length of each dynamic OAuth client redirect URI.
WORKGATE_OAUTH_REGISTRATION_MAX_REDIRECT_URI_CHARS=2048
# Maximum length of a dynamic OAuth client display name.
WORKGATE_OAUTH_REGISTRATION_MAX_CLIENT_NAME_CHARS=200

# Safety and resource limits.
# Disable built-in workspace and command restrictions; use only in disposable containers or VMs. MCP
# safety annotations remain conservative in this mode.
WORKGATE_ALLOW_FULL_CONTROL=false
# Base MCP/HTTP tool watchdog timeout in seconds. Shell execution tools receive additional bounded
# cleanup time beyond run_shell_max_timeout_s.
WORKGATE_TOOL_TIMEOUT_S=60
# Default timeout for bounded shell command calls in seconds.
WORKGATE_RUN_SHELL_DEFAULT_TIMEOUT_S=10
# Maximum timeout accepted by bounded shell command calls in seconds.
WORKGATE_RUN_SHELL_MAX_TIMEOUT_S=120
# Command output limit in bytes.
WORKGATE_MAX_OUTPUT_BYTES=200000
# Maximum retained output bytes for one tracked background-job attempt.
WORKGATE_MAX_JOB_LOG_BYTES=10000000
# Maximum retained tracked-job records; active jobs are never pruned.
WORKGATE_MAX_JOBS=1000
# Maximum durable agent/workspace sessions after stale-session pruning.
WORKGATE_MAX_AGENT_SESSIONS=256
# Idle retention for durable agent/workspace sessions; 0 disables age-based expiry.
WORKGATE_AGENT_SESSION_RETENTION_S=2592000
# Maximum grounding snapshots retained for one agent session.
WORKGATE_MAX_SESSION_SNAPSHOTS=2000
# Maximum encoded grounding-snapshot metadata retained for one session.
WORKGATE_MAX_SESSION_SNAPSHOT_BYTES=8388608
# Per-file read limit in bytes.
WORKGATE_MAX_FILE_READ_BYTES=512000
# Maximum raw bytes accepted by the native MCP image viewer.
WORKGATE_MAX_VIEW_IMAGE_BYTES=20971520
# Maximum number of discovered Skills across all configured sources.
WORKGATE_MAX_SKILLS=256
# Maximum related files returned for one Skill.
WORKGATE_MAX_SKILL_RELATED_FILES=1000
# Maximum filesystem entries inspected during one Skill registry scan.
WORKGATE_MAX_SKILL_SCAN_ENTRIES=5000
# Maximum UTF-8 bytes used by returned related Skill paths.
WORKGATE_MAX_SKILL_PATH_BYTES=200000
# Per-file write/edit limit in bytes.
WORKGATE_MAX_FILE_WRITE_BYTES=5000000
# Maximum grep result count.
WORKGATE_MAX_GREP_RESULTS=200
# Maximum listed directory entries.
WORKGATE_MAX_DIRECTORY_ENTRIES=5000
# Maximum glob search results.
WORKGATE_MAX_GLOB_RESULTS=5000
# Maximum tree-view entries.
WORKGATE_MAX_TREE_ENTRIES=5000
# Todo-list item limit.
WORKGATE_MAX_TODOS=1000
# Todo-list total byte limit.
WORKGATE_MAX_TODO_BYTES=1000000
# Maximum inbound HTTP request-body bytes; 0 disables the shared limit.
WORKGATE_MAX_HTTP_REQUEST_BYTES=16000000
# Maximum active audit JSONL bytes before atomic recent-record retention.
WORKGATE_MAX_AUDIT_LOG_BYTES=20000000
# Maximum encoded bytes retained for one audit event before preview truncation.
WORKGATE_MAX_AUDIT_EVENT_BYTES=1000000
# Store large sanitized audit field values as private content-addressed payloads.
WORKGATE_AUDIT_PAYLOADS_ENABLED=true
# Maximum canonical JSON bytes kept inline for one sanitized audit field value.
WORKGATE_AUDIT_INLINE_VALUE_BYTES=16384
# Maximum canonical JSON bytes accepted for one recoverable sanitized audit payload.
WORKGATE_MAX_AUDIT_PAYLOAD_BYTES=67108864
# Maximum compressed bytes retained in the private audit payload store.
WORKGATE_MAX_AUDIT_PAYLOAD_STORE_BYTES=268435456
# Recovery lifetime and orphan grace period for private audit payload objects.
WORKGATE_AUDIT_PAYLOAD_RETENTION_S=604800
# Temporary-file count limit. When exceeded, old files are deleted.
WORKGATE_MAX_TMP_FILES=500
# Temporary-file byte limit. When exceeded, old files are deleted.
WORKGATE_MAX_TMP_BYTES=50000000
# Maximum entries accepted from one transferred archive.
WORKGATE_MAX_TRANSFER_ARCHIVE_ENTRIES=100000
# Maximum declared regular-file bytes accepted while unpacking an archive.
WORKGATE_MAX_TRANSFER_UNPACKED_BYTES=10000000000
# Concurrent command limit.
WORKGATE_MAX_CONCURRENT_COMMANDS=4
# Persistent shell limit.
WORKGATE_MAX_TMUX_SESSIONS=16
# Enable download links created by protected tools.
WORKGATE_FILE_DOWNLOAD_ENABLED=true
# Default lifetime for file download links in seconds.
WORKGATE_FILE_DOWNLOAD_DEFAULT_TTL_S=3600
# Maximum lifetime accepted for file download links in seconds.
WORKGATE_FILE_DOWNLOAD_MAX_TTL_S=604800
# Default download-count limit for file links; 0 means unlimited until expiry.
WORKGATE_FILE_DOWNLOAD_DEFAULT_MAX_DOWNLOADS=0
# Maximum file size allowed for download links; 0 disables this size limit.
WORKGATE_FILE_DOWNLOAD_MAX_FILE_BYTES=0
# Comma-separated command denylist in env/CLI, or a YAML list in config files. Cleared when
# full-control mode is enabled.
WORKGATE_COMMAND_DENYLIST=docker.sock,/var/run/docker.sock,mkfs,mount,umount,shutdown,reboot,systemctl,iptables,nft
# Comma-separated path denylist in env/CLI, or a YAML list in config files. Cleared when full-control
# mode is enabled.
WORKGATE_PATH_DENYLIST=.ssh/id_rsa,.ssh/id_ed25519,.env,secrets,credentials,.git/config
# Maximum queued or offered ordinary commands retained per executor.
WORKGATE_EXECUTOR_MAX_PENDING_COMMANDS=64

# Remote workers.
# Enable remote worker routes and MCP tools.
WORKGATE_REMOTE_ENABLED=true
# One-time remote worker invite lifetime in seconds.
WORKGATE_REMOTE_INVITE_TTL_S=600
# Remote worker long-poll heartbeat timeout in seconds.
WORKGATE_REMOTE_POLL_TIMEOUT_S=25
# Control-side remote job result timeout in seconds.
WORKGATE_REMOTE_JOB_TIMEOUT_S=3600
# Maximum queued or in-flight remote jobs allowed per worker.
WORKGATE_REMOTE_MAX_PENDING_JOBS=64
# Use the private resumable HTTP gateway for capable large session copies.
WORKGATE_REMOTE_HTTP_TRANSFER_ENABLED=true
# Minimum payload size selected for private HTTP streaming.
WORKGATE_REMOTE_HTTP_TRANSFER_THRESHOLD_BYTES=1048576
# Maximum request or response chunk size for private HTTP transfer routes.
WORKGATE_REMOTE_HTTP_TRANSFER_CHUNK_BYTES=1048576
# Lifetime of a private transfer grant before it must be renewed.
WORKGATE_REMOTE_HTTP_TRANSFER_TICKET_TTL_S=300
# Maximum non-terminal private transfer objects retained concurrently.
WORKGATE_REMOTE_HTTP_TRANSFER_MAX_ACTIVE=16
# Maximum aggregate bytes reserved by private controller transfer spools.
WORKGATE_REMOTE_HTTP_TRANSFER_MAX_SPOOL_BYTES=10737418240

# Agent capability bridge.
# Enable agent capability bridge tools.
WORKGATE_AGENT_BRIDGE_ENABLED=true
# Agent MCP server probe timeout in seconds.
WORKGATE_AGENT_MCP_PROBE_TIMEOUT_S=5
# Agent MCP tool-call timeout in seconds.
WORKGATE_AGENT_MCP_CALL_TIMEOUT_S=60
# Register dynamic MCP bridge tools.
WORKGATE_AGENT_DYNAMIC_MCP_TOOLS=true
# Register dynamic skill bridge tools.
WORKGATE_AGENT_DYNAMIC_SKILL_TOOLS=true

# Tool executables.
# Shell executable for bounded and persistent sessions; the POSIX default maps to COMSPEC on Windows.
WORKGATE_SHELL_EXECUTABLE=/bin/bash
# tmux executable required for persistent shells on POSIX systems.
WORKGATE_TMUX_BIN=tmux
# ripgrep executable.
WORKGATE_RG_BIN=rg
# Git executable used for patch validation and application.
WORKGATE_GIT_BIN=git
# Python executable; the POSIX default maps to the running interpreter on Windows.
WORKGATE_PYTHON_BIN=python3

# Optional Cloudflare tunnel helper settings.
# Optional token consumed by scripts/run-with-cloudflare-tunnel.sh. This uses Cloudflare Tunnel only,
# not Cloudflare Access.
CLOUDFLARE_TUNNEL_TOKEN=
